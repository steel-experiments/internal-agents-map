---
// ABOUTME: The page of one catalog implementation, in the order the contract sets.
// ABOUTME: Every section is built from normalized claims, never from stored HTML.
import SiteLayout from '../../layouts/SiteLayout.astro';
import EntrySection from '../../components/EntrySection.astro';
import Claim from '../../components/Claim.astro';
import Icon from '../../components/Icon.astro';
import CompanyLogo from '../../components/CompanyLogo.astro';
import ResearchDetails from '../../components/ResearchDetails.astro';
import SourceList from '../../components/SourceList.astro';
import { loadCatalog } from '../../lib/catalog';
import { entryView, showQuestion } from '../../lib/entry-view';
import { assertPublishableId, canonicalUrl, organizationPath } from '../../lib/routes';
import {
  SITE_NAME,
  breadcrumbNode,
  metaDescription,
  structuredData,
  webPageNode,
} from '../../lib/metadata';

export function getStaticPaths() {
  return loadCatalog().approaches.map((approach) => {
    assertPublishableId(approach.id);
    return { params: { id: approach.id } };
  });
}

const { id } = Astro.params as { id: string };
const entry = entryView(loadCatalog(), id);

const title = `${entry.agentName} at ${entry.company} · ${SITE_NAME}`;
const description = metaDescription(`${entry.company} — ${entry.agentName}. ${entry.summaryText}`);
const url = canonicalUrl(entry.path);
const graph = structuredData([
  webPageNode({ url, name: title, description, dateModified: entry.reviewedAt }),
  breadcrumbNode(url, [
    { name: entry.profile.label, path: entry.profile.path },
    { name: `${entry.company} — ${entry.agentName}`, path: entry.path },
  ]),
]);

// Invocation and interfaces are classifications, so they sit with the other facts.
// Reviewed entries explain a missing workflow even when there are no claims.
const invocation = entry.invocation.filter((item) => item.id !== 'unknown');
const hasResults =
  entry.metricClaims.length > 0 ||
  entry.resultStatementClaims.length > 0 ||
  entry.isPilot ||
  (!entry.isPilot && entry.lessonClaims.length > 0);
const hasRelated = entry.relatedEntries.length > 0 || entry.relatedNotes.length > 0;
---
<SiteLayout title={title} description={description} path={entry.path} structuredData={graph}>
  <article class="entry-page" data-approach-id={entry.id}>
    <header class="entry-header">
      <CompanyLogo company={entry.companyView} size={40} eager />
      <h1>{entry.agentName}</h1>
      {entry.summary && !entry.isPilot ? (
        <>
          <p class="lede" id={entry.summary.anchor} data-claim-id={entry.summary.id}>{entry.summary.text}</p>
        </>
      ) : !entry.summary ? (
        <p class="lede">This entry has no summary claim yet.</p>
      ) : null}
      <dl class="entry-facts">
        <div>
          <dt>Company</dt>
          <dd><a href={organizationPath(entry.companyView.id)}>{entry.company}</a></dd>
        </div>
        <div>
          <dt>Approach type</dt>
          <dd>{entry.approachTypeLabel}</dd>
        </div>
        <div>
          <dt>{entry.isSupportingSystem ? 'Work supported' : 'Work'}</dt>
          <dd>{entry.domains.map((domain) => domain.label).join(', ')}</dd>
        </div>
        {!entry.isSupportingSystem && <div>
          <dt>Human involvement</dt>
          <dd>{entry.autonomyLabel}</dd>
        </div>}
        {!entry.isSupportingSystem && invocation.length > 0 && (
          <div>
            <dt>Invocation</dt>
            <dd>{invocation.map((item) => item.label).join(', ')}</dd>
          </div>
        )}
        {entry.interfaces.length > 0 && (
          <div>
            <dt>Interfaces</dt>
            <dd>{entry.interfaces.map((item) => item.label).join(', ')}</dd>
          </div>
        )}
        <div>
          <dt>Deployment stage</dt>
          <dd>{entry.deploymentStageLabel}</dd>
        </div>
        <div>
          <dt>Evidence strength</dt>
          <dd>{entry.evidenceStrengthLabel}</dd>
        </div>
        <div>
          <dt>Entry reviewed</dt>
          <dd><time datetime={entry.reviewedAt}>{entry.reviewedAt}</time></dd>
        </div>
      </dl>
    </header>

    {entry.isPilot && (
      <section class="entry-section" id="purpose" aria-labelledby="purpose-title">
        <h2 id="purpose-title">Purpose</h2>
        {entry.summary && <Claim claim={entry.summary} showLabel={false} />}
        <p class="section-note"><a href="#sources">Check the reviewed sources and claim details</a>.</p>
      </section>
    )}

    {entry.profile.sectionOrder.map((section) => <EntrySection entry={entry} section={section} />)}

    {entry.isPilot && showQuestion(entry, 'validation') &&
      (entry.validationClaims.length > 0 || (entry.coverageQuestions.validation?.claimAnchors.length ?? 0) > 0) && (
      <section class="entry-section" id="validation" aria-labelledby="validation-title">
        <h2 id="validation-title">{entry.profile.validation}</h2>
        {entry.validationClaims.length > 0 ? (
          <div class="step-panel">{entry.validationClaims.map((claim) => <Claim claim={claim} />)}</div>
        ) : entry.coverageQuestions.validation?.claimAnchors.length ? (
          <p class="review-state" data-state={entry.coverageQuestions.validation.state}>
            <strong>{entry.coverageQuestions.validation.stateLabel}:</strong>{' '}
            {entry.coverageQuestions.validation.claimAnchors.map((claim, index) => (
              <>{index > 0 && ', '}<a href={`#${claim.anchor}`}>{claim.label}</a></>
            ))}
          </p>
        ) : null}
      </section>
    )}

    {hasResults && showQuestion(entry, 'observations') && (
      <section class="entry-section" id="results" aria-labelledby="results-title">
        <h2 id="results-title">{entry.isPilot ? entry.profile.observations : 'Reported results and limitations'}</h2>
        <p class="section-note">
          The catalog records what the sources report, with the scope and the denominator of every
          figure. A qualification below limits the figure it sits under.
        </p>
        {entry.isPilot ? entry.observationItems.map((item) => (
          <div class="observation-item">
            <p class="section-note"><strong>{item.categoryLabel}</strong> · {item.basisLabel} · {item.subject}</p>
            <Claim claim={item.claim} />
          </div>
        )) : entry.metricClaims.map((claim) => <Claim claim={claim} />)}
        {!entry.isPilot && entry.resultStatementClaims.length > 0 && (
          <>
            <h3>Reported outcomes and statements</h3>
            {entry.resultStatementClaims.map((claim) => <Claim claim={claim} showKind={true} />)}
          </>
        )}
        {entry.isPilot && entry.observationItems.length === 0 && (
          <p class="review-state" data-state={entry.coverageQuestions.observations?.state}><strong>{entry.coverageQuestions.observations?.stateLabel}:</strong> {entry.coverageQuestions.observations?.note}</p>
        )}
        {!entry.isPilot && entry.lessonClaims.length > 0 && (
          <>
            <h3>Lessons and interpretation</h3>
            <div class="step-panel">
              {entry.lessonClaims.map((claim) => (
                <Claim claim={claim} showLabel={false} mark="circle-check" />
              ))}
            </div>
          </>
        )}
      </section>
    )}

    {entry.isPilot && showQuestion(entry, 'lessons') && entry.lessonClaims.length > 0 && (
      <section class="entry-section" id="lessons" aria-labelledby="lessons-title">
        <h2 id="lessons-title">Lessons</h2>
        <div class="step-panel">{entry.lessonClaims.map((claim) => <Claim claim={claim} showLabel={false} mark="circle-check" />)}</div>
      </section>
    )}

    <section class="entry-section" id="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Sources and research details</h2>
      <p class="section-note">
        Citations link to the original publisher. Each source also keeps a preserved copy in the
        repository, so a changed or removed page stays checkable.
      </p>
      <SourceList sources={entry.sources} />
      <details class="claim-details"><summary>Question coverage and scope</summary>
        <dl class="architecture">{Object.entries(entry.coverageQuestions).map(([key, answer]) => <><dt>{key.replaceAll('_', ' ')}</dt><dd>{answer.stateLabel}{answer.note ? `: ${answer.note}` : ''}</dd></>)}</dl>
      </details>
      <ResearchDetails claims={entry.claims} researchOnlyClaims={entry.researchOnlyClaims} aliasRelations={entry.aliasObservationRelations} />
    </section>

    {hasRelated && (
      <section class="entry-section" id="related" aria-labelledby="related-title">
        <h2 id="related-title">Related reading</h2>
        <ul class="related-list">
          {(['used-by', 'uses', 'related'] as const).map((group) => <>
          {entry.relatedEntries.some((item) => item.group === group) && <li><h3>{group === 'used-by' ? 'Agents using this' : group === 'uses' ? 'Infrastructure used' : 'Related implementations'}</h3></li>}
          {entry.relatedEntries.filter((item) => item.group === group).map((related) => (
            <li class="related-card">
              <span class="related-kind"><Icon name="layers-two" />{related.relationLabel}</span>
              <a href={related.path}>{related.company} — {related.agentName}</a>
            </li>
          ))}
          </>)}
          {entry.relatedNotes.map((note) => (
            <li class="related-card">
              <span class="related-kind"><Icon name="note-text" />Note</span>
              <a href={note.path}>{note.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <a class="page-back page-back-end" href={entry.profile.path}>
      <span>Back to {entry.profile.label.toLowerCase()}</span>
      <Icon name="layers-two" />
    </a>
  </article>
</SiteLayout>
