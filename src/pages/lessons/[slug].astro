---
// ABOUTME: One lesson: the authored Markdown body, its sources, and its catalog links.
// ABOUTME: The body comes from the lessons collection, so the prose has one home.
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Icon from '../../components/Icon.astro';
import { loadCatalog } from '../../lib/catalog';
import {
  SITE_NAME,
  articleNode,
  breadcrumbNode,
  structuredData,
} from '../../lib/metadata';
import { longDate, nextLesson, lessonCatalogLinks, lessonViewBySlug } from '../../lib/lessons';
import { ogImage } from '../../lib/og';
import { canonicalUrl, homePath, lessonsIndexPath } from '../../lib/routes';
import { lessonCard } from '../../lib/section-cards';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const lesson = lessonViewBySlug(entry.id);
const { Content } = await render(entry);
const catalog = loadCatalog();
const catalogLinks = lessonCatalogLinks(catalog, lesson);
const next = nextLesson(lesson.slug);

const title = `${lesson.title} · Lessons · ${SITE_NAME}`;
const url = canonicalUrl(lesson.path);
const graph = structuredData([
  articleNode({
    url,
    name: title,
    headline: lesson.title,
    description: lesson.description,
    datePublished: lesson.publishedAt,
    // Only a real content change carries a modification date.
    dateModified: lesson.updatedAt,
  }),
  breadcrumbNode(url, [
    { name: 'Catalog', path: homePath() },
    { name: 'Lessons', path: lessonsIndexPath() },
    { name: lesson.title, path: lesson.path },
  ]),
]);
---
<ArticleLayout
  title={title}
  description={lesson.description}
  path={lesson.path}
  structuredData={graph}
  variant="lessons"
  ogType="article"
  articlePublishedTime={lesson.publishedAt}
  ogImage={ogImage(lesson.path, lessonCard(lesson))}
>
  <div class="lesson-detail">
    <article>
      <header class="guide-header">
        <h1>{lesson.title}</h1>
        <p class="lede">{lesson.lede}</p>
        <p class="lesson-meta">
          First posted <time datetime={lesson.publishedAt}>{longDate(lesson.publishedAt)}</time>
          {lesson.updatedAt && (
            <> · Updated <time datetime={lesson.updatedAt}>{longDate(lesson.updatedAt)}</time></>
          )}
          {' · '}{lesson.readingTime}
        </p>
      </header>
      <Content />
      <section class="lesson-sources" id="sources" aria-labelledby="lesson-sources-title">
        <h2 id="lesson-sources-title">{lesson.sources.length === 1 ? 'Source' : 'Sources'}</h2>
        <ol>
          {lesson.sources.map((source) => (
            <li id={source.anchor}>
              <a href={source.url}>{source.title}</a><span>{source.note}</span>
            </li>
          ))}
        </ol>
        <h3 class="lesson-related-title">Related items</h3>
        <ul class="doc-links">
          {catalogLinks.map((link) => (
            <li class="doc-card">
              <Icon name="layers-two" />
              <a href={link.path}>{link.label}</a>
            </li>
          ))}
        </ul>
      </section>
      <nav class="lesson-next" aria-label="More lessons">
        <a class="button" href={lessonsIndexPath()}>
          <span>All lessons</span>
          <Icon name="note-text" />
        </a>
        <a class="button" href={next.lesson.path}>
          <span>{next.isFirst ? 'Read' : 'Next'}: {next.lesson.title}</span>
          <Icon name="arrow-right" />
        </a>
      </nav>
    </article>
  </div>
</ArticleLayout>
