---
// ABOUTME: Holds the per-claim research ledger behind one native disclosure.
// ABOUTME: It keeps provenance, confidence, and source locators available on the page.
import Icon from './Icon.astro';
import type { ClaimView } from '../lib/entry-view';

interface Props {
  claims: readonly ClaimView[];
  researchOnlyClaims?: readonly ClaimView[];
  aliasRelations?: readonly { readonly claim: ClaimView; readonly target: ClaimView; readonly reason: string }[];
}

const { claims, researchOnlyClaims = [], aliasRelations = [] } = Astro.props;
const researchOnly = new Set(researchOnlyClaims.map((claim) => claim.id));
const aliasById = new Map(aliasRelations.map((item) => [item.claim.id, item]));
---
<details class="claim-details">
  <summary>
    <span>Research details for every claim on this page</span>
    <Icon name="chevron-down" />
  </summary>
  <ol class="ledger">
    {claims.map((claim) => (
      <li>
        {researchOnly.has(claim.id) ? (
          <div id={claim.anchor} data-claim-id={claim.id} class="research-only-claim">
            <strong>{claim.label}</strong>
            <p>{claim.text}</p>
            {aliasById.get(claim.id) && (
              <p>
                Duplicate representation of <a href={`#${aliasById.get(claim.id)!.target.anchor}`}>{aliasById.get(claim.id)!.target.label}</a>.{' '}
                {aliasById.get(claim.id)!.reason}
              </p>
            )}
          </div>
        ) : (
          <a class="ledger-title" href={`#${claim.anchor}`}>{claim.label}</a>
        )}
        <dl>
          <dt>Statement type</dt>
          <dd>{claim.kindLabel}</dd>
          <dt>Provenance</dt>
          <dd>{claim.provenanceLabel}</dd>
          <dt>Confidence</dt>
          <dd>{claim.confidenceLabel}</dd>
          <dt>Confidence reason</dt>
          <dd>{claim.confidenceReason}</dd>
          {claim.metadata.map((field) => (
            <>
              <dt>{field.label}</dt>
              <dd>{field.value}</dd>
            </>
          ))}
        </dl>
        {claim.citations.length > 0 && (
          <ul class="evidence">
            {claim.citations.map((citation) => (
              <li>
                <span class:list={['relation', `relation-${citation.relation}`]}>{citation.relationLabel}</span>
                <span class="citation-source">
                  <a href={`#${citation.anchor}`}>{citation.title}</a>
                  {citation.locator && <span class="locator">{citation.locator}</span>}
                </span>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
</details>
