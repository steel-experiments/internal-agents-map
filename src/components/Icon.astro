---
// ABOUTME: Draws one icon from the Steel central icon set, inlined as SVG.
// ABOUTME: The set ships React components; only the path data is carried here.
interface Props {
  /** The icon to draw. Every name matches its `icon-<name>` in the set. */
  name: keyof typeof PATHS;
  size?: number;
}

