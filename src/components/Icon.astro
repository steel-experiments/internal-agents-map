/** The marks the set draws as a filled shape rather than a stroked line. */
const FILLED = new Set(['github']);

/**
 * A mark drawn as a solid shape with its detail knocked out of it. The set
 * draws these as outlines; filling the disc and reversing the check reads
 * better at 16px than a ring would.
 */
const TWO_TONE: Record<string, { readonly disc: string; readonly mark: string }> = {
  'circle-check': {
    disc: 'M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z',
    mark: 'M15 9.5L10.5 15L8.5 13',
  },
};

const { name, size = 16 } = Astro.props;
const filled = FILLED.has(name);
const twoTone = TWO_TONE[name];
---
<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>{twoTone ? (
  <>
    <path d={twoTone.disc} fill="currentColor" stroke="none" />
    <path d={twoTone.mark} fill="none" stroke="var(--sand-1)" />
  </>
) : (
  <path d={PATHS[name]} />
)}</svg>
