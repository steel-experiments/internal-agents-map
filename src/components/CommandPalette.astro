---
// ABOUTME: The command palette: one search over the catalog, the notes, and the definitions.
// ABOUTME: Every item is a link in the initial HTML, so the palette filters rather than fetches.
import Icon from './Icon.astro';
import { loadCatalog } from '../lib/catalog';
import { directoryCards } from '../lib/entry-view';
import { DEFINITIONS_JUMP_LINKS } from '../lib/guide-content';
import { notePreviewTitle, noteViews } from '../lib/notes';
import { guidePath } from '../lib/routes';
import { FACET_KEYS, FACET_LABELS, facetVocabulary, normalize } from '../lib/search';

const cards = directoryCards(loadCatalog());
const notes = noteViews();
const vocabulary = facetVocabulary(cards);

/** The facet values each pill offers, in the order the vocabulary lists them. */
const facets = FACET_KEYS.map((key) => ({
  key,
  label: FACET_LABELS[key],
  // A level reads as "lv." here: the pill has room for the boundary, not the word.
  terms: vocabulary
    .filter((term) => term.key === key)
    .map((term) => ({ ...term, label: term.label.replace(' (level ', ' (lv. ') })),
})).filter((facet) => facet.terms.length > 0);

/** Only the catalog carries facets; the other groups state none rather than omit them. */
const NO_FACETS = { work: '', type: '', invocation: '', supervision: '' };

/** A catalog entry carries its facets, so a pill can hide it without a round trip. */
const catalogItems = cards.map((card) => ({
  collection: card.catalogSection,
  path: card.path,
  title: `${card.company} · ${card.agentName}`,
  detail: card.approachTypeLabel,
  search: card.search,
  facets: {
    work: card.domains.map((domain) => domain.id).join(' '),
    type: card.approachType,
    invocation: card.invocation.map((mode) => mode.id).join(' '),
    supervision: card.boundaries.map((boundary) => boundary.id).join(' '),
  },
}));

const noteItems = notes.map((note) => ({
  path: note.path,
  title: notePreviewTitle(note),
  detail: note.readingTime,
  search: normalize(`${notePreviewTitle(note)} ${note.summary}`),
  facets: NO_FACETS,
}));

const definitionItems = DEFINITIONS_JUMP_LINKS.map((link) => ({
  path: `${guidePath('definitions')}#${link.fragment}`,
  title: link.label.replace(/\s*↓$/, ''),
  detail: '',
  search: normalize(link.label.replace(/\s*↓$/, '')),
  facets: NO_FACETS,
}));

const groups = [
  { id: 'catalog', label: 'Agents', items: catalogItems.filter((item) => item.collection === 'agents') },
  { id: 'infrastructure', label: 'Infrastructure', items: catalogItems.filter((item) => item.collection === 'infrastructure') },
  { id: 'notes', label: 'Notes', items: noteItems },
  { id: 'definitions', label: 'Definitions', items: definitionItems },
];
---
<div class="palette" id="palette" hidden>
  <div class="palette-scrim" data-palette-dismiss></div>
  <div class="palette-panel" role="dialog" aria-modal="true" aria-label="Search the map">
    <div class="palette-search">
      <Icon name="search" size={20} />
      <input
        id="palette-input"
        type="search"
        autocomplete="off"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-results"
        placeholder="Search for anything in the map…"
      />
      <kbd class="palette-hint">Esc</kbd>
      <button type="button" class="palette-round palette-filter-open" aria-controls="palette-filters">
        <span class="visually-hidden">Filters</span>
        <Icon name="filter" size={18} />
      </button>
      <button type="button" class="palette-round" data-palette-dismiss>
        <span class="visually-hidden">Close</span>
        <Icon name="close" size={18} />
      </button>
    </div>
    <div class="palette-filters" id="palette-filters">
      <div class="palette-facet" data-facet="group">
        <button type="button" class="palette-pill" aria-expanded="false">
          <span class="palette-pill-label">Content type</span>
          <span class="palette-pill-count" hidden></span>
          <Icon name="chevron-down" />
        </button>
        <ul class="palette-menu" hidden>
          {groups.map((group) => (
            <li>
              <button type="button" class="palette-option" data-value={group.id} aria-pressed="false">
                <span>{group.label}</span>
                <Icon name="check" size={16} />
              </button>
            </li>
          ))}
        </ul>
      </div>
      {facets.map((facet) => (
        <div class="palette-facet" data-facet={facet.key}>
          <button type="button" class="palette-pill" aria-expanded="false">
            <span class="palette-pill-label">{facet.label}</span>
            <span class="palette-pill-count" hidden></span>
            <Icon name="chevron-down" />
          </button>
          <ul class="palette-menu" hidden>
            {facet.terms.map((term) => (
              <li>
                <button type="button" class="palette-option" data-value={term.id} aria-pressed="false">
                  <span>{term.label}</span>
                  <Icon name="check" size={16} />
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="palette-filters-foot">
        <button type="button" class="palette-apply" disabled>Apply filters</button>
        <button type="button" class="palette-back">Go back</button>
      </div>
    </div>
    <div class="palette-results" id="palette-results" role="listbox" aria-label="Results">
      {groups.map((group) => (
        <section class="palette-group" data-group={group.id}>
          <p class="palette-group-name">{group.label}</p>
          <ul>
            {group.items.map((item) => (
              <li>
                <a
                  class="palette-item"
                  href={item.path}
                  role="option"
                  aria-selected="false"
                  data-search={item.search}
                  data-group={group.id}
                  data-work={item.facets.work}
                  data-type={item.facets.type}
                  data-invocation={item.facets.invocation}
                  data-supervision={item.facets.supervision}
                >
                  <span class="palette-item-title">{item.title}</span>
                  <span class="palette-item-detail">{item.detail}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="palette-empty" hidden>Nothing matches this search.</p>
    </div>
  </div>
</div>
