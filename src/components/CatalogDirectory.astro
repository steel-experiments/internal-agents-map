---
// ABOUTME: The directory: one compact card per implementation, all in the initial HTML.
// ABOUTME: The filter form only hides cards, so every entry link stays crawlable.
import SiteLayout from '../layouts/SiteLayout.astro';
import AgentCard from '../components/AgentCard.astro';
import { loadCatalog, collectionCounts } from '../lib/catalog';
import { directoryCards } from '../lib/entry-view';
import { documentationOrder } from '../lib/documentation';
import { canonicalUrl, homePath } from '../lib/routes';
import { SITE_DESCRIPTION, SITE_NAME, datasetNode, structuredData, webPageNode } from '../lib/metadata';
import { ogImage } from '../lib/og';
import { INFRASTRUCTURE_DESCRIPTION, INFRASTRUCTURE_HEADING, SECTION_CARDS } from '../lib/section-cards';
import { lessonViewBySlug } from '../lib/lessons';
import { PROBLEMS } from '../lib/problems';
import Icon from './Icon.astro';

interface Props { collection?: 'agents' | 'infrastructure' }
const { collection = 'agents' } = Astro.props;
const infrastructure = collection === 'infrastructure';
const catalog = loadCatalog();
const cards = documentationOrder(directoryCards(catalog));
const counts = { agents: collectionCounts(catalog, 'agents'), infrastructure: collectionCounts(catalog, 'infrastructure') };
const scopedCounts = counts[collection];
/** The lessons that the homepage offers as design questions after the catalog. */
const decisions = ['stop-a-run', 'steps-without-a-model', 'review-noise'].map(lessonViewBySlug);
const reviewed = catalog.approaches
  .map((approach) => approach.last_reviewed_at)
  .sort()
  .at(-1);

const title = `${infrastructure ? 'Infrastructure · ' : ''}${SITE_NAME} · How companies build internal AI agents`;
const description = infrastructure ? INFRASTRUCTURE_DESCRIPTION :
  'A source-backed catalog of AI systems organizations build for their own teams. ' +
  'Explore approaches, operating models, and reported evidence.';
const path = infrastructure ? '/infrastructure' : homePath();
const url = canonicalUrl(path);
const graph = structuredData([
  webPageNode({ url, name: title, description, dateModified: reviewed }),
  ...(!infrastructure ? [datasetNode({ description: SITE_DESCRIPTION, dateModified: reviewed })] : []),
]);
const preview = infrastructure ? ogImage(path, SECTION_CARDS.infrastructure) : null;
---
<SiteLayout title={title} description={description} path={path} current={infrastructure ? 'infrastructure' : 'catalog'} structuredData={graph} ogImage={preview}>
  <header class="intro">
    <script is:inline id="collection-counts" type="application/json" set:html={JSON.stringify(counts)} />
    <h1 id="directory-heading">{infrastructure ? INFRASTRUCTURE_HEADING : 'How companies build internal AI agents'}</h1>
    <p>{infrastructure ? 'Explore the platforms, execution environments, and tool access that make internal agents possible.' : `Case studies of AI agents that organizations build or adapt to do work for their own teams. Each of the ${scopedCounts.entries} shows the workflow, tools, and human review steps, with every claim linked to a saved public source.`}</p>
    <div class="stats" id="collection-stats">
      <div class="stat"><strong>{scopedCounts.entries}</strong><span>{infrastructure ? 'infrastructure records' : 'agents'}</span></div>
      <div class="stat"><strong>{scopedCounts.organizations}</strong><span>organizations</span></div>
      <div class="stat"><strong>{scopedCounts.sources}</strong><span>sources</span></div>
    </div>
    {!infrastructure && (
      <nav class="problem-links" aria-labelledby="problems-title">
        <h2 id="problems-title">Start with a problem</h2>
        <ul>
          {PROBLEMS.map((problem) => <li><a href={problem.path}>{problem.label}</a></li>)}
        </ul>
      </nav>
    )}
  </header>
  <section id="catalog" data-default-collection={collection} aria-labelledby="catalog-title">
    <h2 id="catalog-title" class="visually-hidden">Explore the catalog</h2>
    {(['agents', 'infrastructure'] as const).map((section) => (
      <div class="entries collection-group" data-collection-group={section} hidden={section !== collection}>
        {section === 'infrastructure' && <h2 class="collection-heading">Infrastructure</h2>}
        {cards.filter((card) => card.catalogSection === section).map((card) => <AgentCard card={card} />)}
      </div>
    ))}
  </section>
  {!infrastructure && (
    <section class="entry-section" id="decisions" aria-labelledby="decisions-title">
      <h2 id="decisions-title">Decisions you will face</h2>
      <ul class="related-list">
        {decisions.map((lesson) => (
          <li class="related-card">
            <span class="related-kind"><Icon name="note-text" />Lesson</span>
            <a href={lesson.path}>{lesson.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</SiteLayout>
<script>
  import { startDirectory } from '../scripts/directory';

  // The router builds this page again on every visit, so the directory is
  // wired per build rather than once at first load.
  document.addEventListener('astro:page-load', () => startDirectory());
</script>
