---
// ABOUTME: The frame the guides and the notes share, wrapped around the site shell.
// ABOUTME: It also carries the reading styles those pages use, ported from the old site.
import SiteLayout from './SiteLayout.astro';
import type { JsonLdNode } from '../lib/metadata';

interface Props {
  title: string;
  description: string;
  /** The canonical path of this page. */
  path: string;
  current?: 'catalog' | 'definitions' | 'notes' | 'methodology' | null;
  structuredData?: JsonLdNode | null;
  /** `notes` adds the reading width and type size the notes use. */
  variant?: 'guide' | 'notes';
  /** A note is an article; a guide is an ordinary page. */
  ogType?: 'website' | 'article';
  /** The publication date of an article, for link previews. */
  articlePublishedTime?: string | null;
}

const {
  title,
  description,
  path,
  current = null,
  structuredData = null,
  variant = 'guide',
  ogType = 'website',
  articlePublishedTime = null,
} = Astro.props;
---
<SiteLayout
  title={title}
  description={description}
  path={path}
  current={current}
  structuredData={structuredData}
  ogType={ogType}
  articlePublishedTime={articlePublishedTime}
>
  <div class:list={['guide', variant === 'notes' && 'notes']}>
    <slot />
  </div>
</SiteLayout>

<style is:global>
/* The guides and the notes read as documents: fine rules, wide measure, quiet labels. */
.guide-header { padding-bottom: 32px; }
.guide-header h1 { max-width: 700px; margin-top: 0; }
.guide-header > p { max-width: 680px; }
.guide-header .lede { font-size: var(--text-sm); line-height: 1.5; margin-top: 24px; }
.guide p { line-height: 1.65; }
.guide section > p { max-width: 680px; }
.guide section > .eyebrow { margin-bottom: 12px; }
.guide section > h2 { margin-bottom: 8px; }
.guide section > h3 + p { margin-top: 12px; }
.guide section > p + p { margin-top: 16px; }
.guide section { padding: 32px 0; }
.guide section > h3 { margin-top: 32px; max-width: 680px; }
.guide h3 { font-size: var(--text-md); font-weight: 500; }
.guide figure { margin: 32px 0; }
.guide figcaption { color: var(--muted); font-size: var(--text-xs); line-height: 1.65; margin-top: 24px; }
.guide blockquote { margin: 24px 0; padding: 8px 0; font-size: var(--text-sm); }
.diagram-number { display: block; color: var(--link); font-size: var(--text-xs); }

/* The chart shows two questions about an implementation, not a score. */
/* The scale row's height is stated, so the vertical scale can span the plot exactly. */
.quadrant-chart { --scale-row: 20px; --scale-gap: 16px; --cell-inset: 20px; position: relative; display: grid; gap: var(--scale-gap); }
/* Standard sits at the foot of the scale, company-specific at its head. */
.quadrant-y-axis {
  position: absolute;
  top: 0;
  bottom: calc(var(--scale-row) + var(--scale-gap));
  right: calc(100% + var(--scale-gap));
  width: 1.2em;
  font-size: var(--text-xs);
  color: var(--muted);
}
.quadrant-y-axis span {
  position: absolute;
  left: 0;
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  white-space: nowrap;
}
.quadrant-y-axis span:first-child { bottom: var(--cell-inset); }
.quadrant-y-axis span:last-child { top: var(--cell-inset); }
.quadrant-plot {
  aspect-ratio: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(2, minmax(0, 1fr));
  border: .5px solid var(--sand-6);
  border-radius: 16px;
  /* The fill is the plot's own, so nothing needs clipping and a name near an
     edge can run past it rather than being cut. */
  background: var(--sand-3);
}
.quadrant-cell { position: relative; min-width: 0; }
/* The two axes carry the same hairline as the square they divide. */
.quadrant-cell:nth-child(odd) { border-right: .5px solid var(--sand-6); }
.quadrant-cell:nth-child(-n+2) { border-bottom: .5px solid var(--sand-6); }
.quadrant-cell h3 { position: absolute; top: var(--cell-inset); left: var(--cell-inset); right: var(--cell-inset); margin: 0; font-size: 14px; line-height: 1.35; font-weight: 500; color: var(--ink); letter-spacing: -.015em; }
.quadrant-cell h3 span { display: block; margin-bottom: 4px; color: var(--muted); font-size: 14px; line-height: 1.35; font-weight: 400; }
.quadrant-cell:nth-child(n+3) h3 { top: auto; bottom: var(--cell-inset); }
/* The two right-hand cells read from the edge they sit against. */
.quadrant-cell:nth-child(2) h3, .quadrant-cell:nth-child(4) h3 { text-align: right; }
.quadrant-cell ul { margin: 0; padding: 0; list-style: none; }
.quadrant-cell li { position: absolute; left: 15%; top: 34%; max-width: 78%; font-size: 14px; padding-left: 20px; }
.quadrant-cell li:nth-child(2) { left: 33%; top: 65%; }
.quadrant-assistants li { left: 12%; top: 15%; }
.quadrant-assistants li:nth-child(2) { left: 33%; top: 37%; }
.quadrant-assistants li:nth-child(3) { left: 20%; top: 60%; }
.quadrant-cell li::before {
  content: "";
  position: absolute;
  left: 0;
  top: calc((1.35em - 12.5px) / 2);
  width: 12.5px;
  height: 12.5px;
  border-radius: 50%;
  background: var(--blue-9);
}
.quadrant-cell a { display: block; line-height: 1.35; text-decoration: none; }
.quadrant-cell a:hover { color: var(--sand-10); }
.quadrant-cell li strong { display: block; font-size: 14px; font-weight: 500; line-height: 1.35; }
.quadrant-cell li span { display: block; font-size: 14px; line-height: 1.35; margin-top: 4px; }
.quadrant-cell .reference-marker { color: var(--sand-10); }
.quadrant-cell .reference-marker strong { color: var(--sand-12); }
/* A reference names a class of product: breaking it reads as two of them. */
.quadrant-cell .reference-marker { max-width: none; white-space: nowrap; }
.quadrant-cell .reference-marker::before {
  top: calc((1.35em - 12px) / 2);
  border-radius: 0;
  width: 12px;
  height: 12px;
  background: var(--green-9);
  clip-path: var(--triangle);
}
.quadrant-cell li[data-chart-reference="deep-research"] { left: 5%; top: 42%; max-width: 40%; }
.quadrant-cell li[data-chart-reference="ready-made-task"] { left: 49%; top: 42%; max-width: 48%; }
.quadrant-cell li[data-chart-reference="general-assistant"] { left: 28%; top: 34%; max-width: 66%; }
.quadrant-cell li[data-chart-approach-id="doordash-code-review"] { left: 10%; top: 30%; max-width: 56%; }
.quadrant-cell li[data-chart-approach-id="posthog-stamphog"] { left: 15%; top: 72%; max-width: 46%; }
.quadrant-cell li[data-chart-approach-id="ramp-inspect"] { left: 60%; top: 76%; max-width: 35%; }
.quadrant-cell li[data-chart-approach-id="stripe-minions"] { left: 56%; top: 48%; max-width: 40%; }
.quadrant-cell li[data-chart-approach-id="brex-agent-platform"] { left: 10%; top: 30%; max-width: 58%; }
.quadrant-cell li[data-chart-approach-id="sentry-junior"] { left: 56%; top: 50%; max-width: 38%; }
.quadrant-cell li[data-chart-approach-id="shopify-internal-agents"] { left: 17%; top: 72%; max-width: 52%; }
.quadrant-x-axis { display: flex; justify-content: space-between; gap: 12px; padding: 0 var(--cell-inset); font-size: var(--text-xs); line-height: var(--scale-row); color: var(--muted); }
.quadrant-legend { display: flex; flex-wrap: wrap; gap: 12px 24px; margin: 24px 0 12px; color: var(--muted); font-size: var(--text-sm); }
.quadrant-legend span { display: inline-flex; align-items: center; gap: 8px; }
.quadrant-legend i { width: 12.5px; height: 12.5px; }
.quadrant-legend .catalog-marker { border-radius: 50%; background: var(--blue-9); }
.quadrant-legend .reference-marker-key { width: 12px; height: 12px; background: var(--green-9); clip-path: var(--triangle); }
/* The plot is the body's own width, so its scale label has room outside it. */
.guide .quadrant-figure { max-width: none; }
.guide-faq details {
  background: var(--sand-3);
  border-radius: 10px;
  overflow: hidden;
}
.guide-faq details + details { margin-top: 12px; }
.guide-faq summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 40px;
  padding: 8px 12px;
  cursor: pointer;
  font-weight: 400;
  line-height: 1.5;
}
@media (hover: hover) {
.guide-faq details:hover { background: var(--sand-4); }
}
.guide-faq summary::before { content: none; }
.guide-faq summary .icon { flex: none; color: var(--sand-10); }
.guide-faq details[open] > summary .icon { transform: rotate(180deg); }
.guide-faq details p { margin: 0; padding: 0 12px 12px; max-width: 680px; color: var(--muted); }
.dimension-intro { display: grid; gap: 24px; margin-top: 24px; }
.dimension-intro h3 { font-size: var(--text-md); line-height: 1.3; margin-bottom: 8px; }
.dimension-intro p { font-size: var(--text-sm); color: var(--muted); }

/* A company workflow supplies the context around model-directed work. */
.workflow-stack {
  display: grid;
  justify-items: center;
  padding: 24px;
  background: #fff;
  border: .5px solid var(--sand-6);
  border-radius: 16px;
}
.workflow-node {
  width: fit-content;
  max-width: 100%;
  background: var(--sand-3);
  border-radius: 16px;
  padding: 16px;
  text-align: center;
}
.workflow-node .eyebrow { font-size: var(--text-xs); }
.workflow-node strong { display: block; font-weight: 400; margin-top: 2px; }
.workflow-context { background: var(--sand-3); }
/* A drawn arrow, clear of the panel above it and the one below. */
.workflow-connector { display: flex; justify-content: center; padding: 4px 0; }
.workflow-connector svg { display: block; width: 12px; height: 32px; fill: none; stroke: var(--sand-9); stroke-width: .5; }
.placement-notes { padding: 24px 0; margin-top: 24px; }
.placement-notes summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  cursor: pointer;
}
.placement-notes summary::before { content: none; }
.placement-notes summary .icon { flex: none; width: 20px; height: 20px; color: var(--sand-10); }
.placement-notes[open] > summary .icon { transform: rotate(180deg); }
.placement-notes ul { list-style: none; padding: 0; }
.placement-notes li { margin-top: 24px; font-size: var(--text-sm); }
.placement-notes li strong { font-weight: 400; }
.placement-notes li p { margin: 8px 0; }
.placement-notes .reference-placement { color: var(--muted); }

/* Definition illustrations share one visual vocabulary: a teal dot is the agent. */
.core-definition { padding: 64px 24px; margin: 24px 0; background: var(--sand-3); border-radius: 14px; text-align: center; }
.combination-title { font-size: var(--text-sm); line-height: 1.5; }
.combination-title strong { font-weight: 400; }
.guide .core-definition p { font-size: var(--text-md); font-weight: 500; line-height: 1.4; margin: 0 auto; max-width: 440px; color: var(--blue-9); }
.guide .core-definition strong { font-weight: 500; color: var(--blue-9); }
/* A call to action stands clear of the paragraph that leads into it. */
.guide section > .button { margin-top: 16px; }
/* The illustration stands on the page's own ground, as tall as it needs. */
.scope-figure {
  width: 100%;
  margin: 24px 0 0;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
}
.scope-figure svg { display: block; width: 100%; height: auto; }
.scope-figure .scope-portrait { display: none; }
.scope-frame { fill: none; stroke: var(--sand-6); stroke-width: .5; }
/* The viewBox is the body's own width, so a label reads at its stated size. */
.scope-label { fill: var(--muted); font-size: 14px; letter-spacing: -.01em; }
.scope-link { fill: none; stroke: var(--sand-6); stroke-width: 1.2; }
/* The agent, what it reaches, and what passes between them share one colour. */
.scope-node { fill: var(--blue-9); stroke: var(--blue-9); stroke-width: 1.2; }
.scope-agent { fill: var(--blue-9); stroke: var(--blue-9); }
.scope-signal { fill: var(--blue-9); }
.concept-pair svg { display: block; width: 100%; fill: none; stroke: var(--sand-10); stroke-width: 1.2; }
.concept-pair svg text { fill: var(--muted); stroke: none; font: 12px Areal, sans-serif; }
.concept-pair svg .agent-dot { fill: var(--accent); stroke: var(--accent); }
.guide .concept-definition { font-size: var(--text-sm); line-height: 1.5; max-width: 610px; }
/* Where an agent runs: one panel per answer, each a field of its own. */
.place-panels { display: grid; gap: 16px; margin: 24px 0; }
.guide .place-panel { margin: 0; }
.place-panel {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding: 16px;
  margin: 0;
  background: #fff;
  border: .5px solid var(--sand-6);
  border-radius: 16px;
}
.guide .place-panel figcaption { margin: 0; font-size: var(--text-sm); line-height: 1.4; }
.place-panel figcaption strong { display: block; color: var(--ink); font-weight: 500; }
.place-panel figcaption span { display: block; margin-top: 8px; color: var(--muted); }
.place-scene { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; gap: 4px; }
.place-scene-wide { display: block; }
.exchange-scene, .cycle-scene { height: auto; }
/* Every column carries a title row, so the boxes line up whether or not it is filled. */
.place-machine, .place-link {
  --title-row: 20px;
  --title-gap: 8px;
  --box-width: 240px;
  --box-height: calc(var(--box-width) * 9 / 16);
  --dot-size: 18px;
  position: relative;
  display: grid;
  grid-template-rows: auto auto;
  gap: var(--title-gap);
}
.place-machine { flex: 0 0 var(--box-width); min-width: 0; }
.place-machine-title { display: block; min-height: var(--title-row); font-size: var(--text-sm); line-height: 20px; text-align: center; color: var(--sand-12); }
.place-box { position: relative; aspect-ratio: 16 / 9; background: var(--sand-3); border-radius: 12px; }
/* The mark holds the centre of the machine. */
.place-agent-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--blue-8);
}
/*
 * The label stands outside the machine and points back in at the mark.
 * The arrow starts six below the mark and the label six below the arrow,
 * which carries it past the box's own edge.
 */
.place-callout {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: calc(var(--title-row) + var(--title-gap) + var(--box-height) + 6px);
  display: grid;
  justify-items: center;
  gap: 6px;
  white-space: nowrap;
  font-size: var(--text-sm);
  color: var(--blue-9);
}
.place-callout svg { display: block; width: 12px; height: 28px; fill: none; stroke: var(--blue-9); stroke-width: 1; }
/* A running agent is not a still one, so its mark breathes. */
@keyframes place-pulse {
  from { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1.2); opacity: .65; }
  to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
}
@media (prefers-reduced-motion: no-preference) {
  .place-agent-dot { animation: place-pulse 2.4s ease-in-out infinite; }
}
.place-link { flex: none; }
.exchange-scene { display: block; width: 100%; height: 100%; }
.exchange-scene, .exchange-strand { fill: none; stroke: var(--sand-10); stroke-width: 1.2; }
.exchange-you { fill: #fff; stroke: var(--sand-10); stroke-width: 1.2; }
.exchange-agent { fill: var(--blue-9); stroke: var(--blue-9); }
.exchange-scene text { fill: var(--muted); stroke: none; }
.exchange-signal { fill: var(--blue-9); stroke: none; }
/* A trigger arrives, the agent works, a result lands, and it begins again. */
.cycle-scene { display: block; width: calc(100% + 16px); height: 100%; margin-left: -16px; }
.cycle-scene text { fill: var(--muted); stroke: none; }
.cycle-link { fill: none; stroke: var(--sand-6); stroke-width: 1.2; }
.cycle-trigger { fill: #fff; stroke: var(--sand-6); stroke-width: 1.2; }
/* The lit state is its own circle, so it can rise and fall on top of the first. */
.cycle-trigger-on { fill: var(--blue-9); stroke: var(--blue-9); stroke-width: 1.2; }
.cycle-agent { fill: var(--blue-9); }
.cycle-spinner { fill: none; stroke: #fff; stroke-width: 2.5; stroke-linecap: round; }
.cycle-result { fill: #fff; stroke: var(--sand-6); stroke-width: 1.2; }
.cycle-result-dot { fill: var(--blue-9); }
.cycle-signal { fill: var(--blue-9); }
.place-arrow { align-self: center; width: 64px; fill: none; stroke: var(--sand-9); stroke-width: 1.2; }
.concept-pair { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); max-width: 680px; margin: 24px 0; }
.guide .concept-pair figure { margin: 0; padding: 24px 16px; min-width: 0; }
.concept-pair figure + figure { border-left: 1px solid var(--sand-6); }
.guide .concept-pair figcaption { margin: 16px 0 0; line-height: 1.5; }
.concept-pair figcaption strong { display: block; color: var(--ink); font-size: var(--text-md); margin-bottom: 8px; }
.concept-pair figcaption span { display: block; font-size: var(--text-sm); }
.concept-combination { max-width: 680px; margin: 32px 0; }
.guide .concept-combination > p { font-size: var(--text-sm); line-height: 1.5; margin: 0; }
/* The three questions read as the table a catalog entry states its caveats in. */
.concept-combination dl {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 0;
  margin: 16px 0;
  font-size: var(--text-sm);
  color: var(--muted);
  border: .5px solid var(--sand-6);
  border-radius: 14px;
  /* The header fill is square and would paint over the rounded corners. */
  overflow: hidden;
}
.concept-combination dl > div { display: contents; }
.concept-combination dt, .concept-combination dd {
  margin: 0;
  padding: 10px 12px;
  line-height: 20px;
  border-bottom: .5px solid var(--sand-6);
}
.concept-combination dt {
  background: var(--sand-3);
  color: var(--ink);
  border-right: .5px solid var(--sand-6);
}
/* Each row is its own element, so the last row is what drops the rule. */
.concept-combination dl > div:last-child dt,
.concept-combination dl > div:last-child dd { border-bottom: 0; }
.guide .concept-combination .combination-note { font-size: var(--text-sm); color: var(--muted); }

/* Notes use the same fine rules, type, and restrained diagram accents. */
.notes { font-size: var(--text-sm); }
.notes .note-meta { font-size: var(--text-xs); color: var(--sand-10); }
.notes .guide-header { padding-bottom: 32px; }
.notes .guide-header > * { max-width: 680px; }
.notes .note-list, .note-detail > article { max-width: 680px; }
.note-preview { position: relative; margin-bottom: 40px; cursor: pointer; }
.note-preview h2 a::after { content: ""; position: absolute; inset: 0; }
.note-preview h2 { margin: 0 0 8px; }
.note-preview h2 a { color: var(--ink); text-decoration: none; }
.note-summary { font-size: var(--text-sm); color: var(--sand-10); max-width: 580px; }
.note-preview:hover h2 a { color: var(--sand-11); }
.note-preview:hover .note-summary { color: var(--sand-9); }
.note-preview:hover .tag { color: var(--sand-11); }
.notes-editorial { max-width: 620px; padding: 24px 0 32px; color: var(--muted); font-size: var(--text-sm); }
.note-back { display: inline-block; margin-bottom: 32px; font-size: var(--text-sm); }
.note-detail h1 { max-width: 640px; }
.notes section { padding: 32px 0; }
.notes blockquote { margin: 32px 0 8px; padding: 8px 0 0; font-size: var(--text-md); }
.notes .quote-credit { color: var(--muted); font-size: var(--text-sm); margin: 0 0 24px; }
.notes table { width: 100%; table-layout: fixed; border-spacing: 0; margin: 24px 0; border: .5px solid var(--sand-6); border-radius: 14px; overflow: hidden; }
.notes th, .notes td { padding: 12px; text-align: left; vertical-align: top; line-height: 1.5; overflow-wrap: anywhere; }
.notes th { background: var(--sand-3); font-weight: 500; }
.notes th:first-child { width: 30%; }
.notes tbody td { border-top: .5px solid var(--sand-6); }
.notes .note-diagram { margin: 32px 0 0; }
.note-node {
  min-width: 0;
  background: var(--sand-3);
  border-radius: 14px;
  padding: 16px;
}
.note-node strong { display: block; font-size: var(--text-md); font-weight: 400; line-height: 1.4; }
/* A node standing on its own is a caption, not a step: both its lines read at 14px. */
.note-diagram > .note-node strong { font-size: var(--text-sm); line-height: 1.5; }
.note-node small { display: block; color: var(--muted); font-size: var(--text-sm); line-height: 1.5; margin-top: 6px; }
.note-diagram-tail { margin-top: 16px; font-size: var(--text-sm); }
.note-reviewers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
/* Branch labels carry the conditions in both the page and the text export. */
.notes .note-branches { list-style: none; margin: 0 0 0 16px; padding: 16px 0 0 20px; border-left: 1px solid var(--sand-6); }
.note-branches li { position: relative; padding: 12px 16px; background: var(--sand-3); border-radius: 14px; }
.note-branches li + li { margin-top: 12px; }
/* A branch meets its container at the middle of its side, whatever its height. */
.note-branches li::before { content: ""; position: absolute; top: 50%; left: -20px; width: 20px; border-top: 1px solid var(--sand-6); }
/* The junction sits astride that edge: half on the line, half on the container. */
.note-branches li::after {
  content: "";
  position: absolute;
  top: 50%;
  left: -6px;
  width: 12px;
  height: 12px;
  transform: translateY(-50%);
  border-radius: 50%;
  background: var(--sand-6);
}
.note-branches strong, .note-shared-state strong { display: block; font-weight: 500; }
.note-branches span, .note-shared-state span { display: block; margin-top: 6px; color: var(--sand-10); }
.note-shared-state { position: relative; margin-top: 16px; padding: 16px; border: 1px solid var(--sand-6); border-radius: 14px; text-align: center; }
.note-shared-state::before, .note-shared-state::after { content: ""; position: absolute; top: -17px; height: 16px; border-left: 1px solid var(--sand-6); }
.note-shared-state::before { left: 25%; }
.note-shared-state::after { left: 75%; }
.notes .note-diagram figcaption {
  margin-top: 16px;
  font-size: var(--text-xs);
  color: var(--sand-10);
}
.notes figcaption { font-size: var(--text-sm); margin-top: 16px; }
.guide .note-sources > h2 { margin-bottom: 16px; }
