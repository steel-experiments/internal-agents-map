---
// ABOUTME: The shared page frame: head metadata, sidebar navigation, and footer.
// ABOUTME: Every page passes its own title, description, and structured data.
import '../styles/site.css';
import ContributionInvite from '../components/ContributionInvite.astro';
import { ClientRouter } from 'astro:transitions';
import CommandPalette from '../components/CommandPalette.astro';
import Icon from '../components/Icon.astro';
import { canonicalUrl, guidePath, homePath, markdownPath, notesIndexPath } from '../lib/routes';
import {
  OG_IMAGE,
  OG_IMAGE_ALT,
  SITE_NAME,
  jsonLdScript,
  type JsonLdNode,
} from '../lib/metadata';

interface Props {
  title: string;
  description: string;
  /** The canonical path of this page, such as `/agents/block-builderbot`. */
  path: string;
  /** The navigation entry to mark as current. */
  current?: 'infrastructure' | 'catalog' | 'definitions' | 'notes' | 'methodology' | null;
  structuredData?: JsonLdNode | null;
  /** Keep a page such as 404 out of search results. */
  noindex?: boolean;
  /** A note is an article; every other page is an ordinary page. */
  ogType?: 'website' | 'article';
  /** The publication date of an article, for link previews. */
  articlePublishedTime?: string | null;
}

const {
  title,
  description,
  path,
  current = null,
  structuredData = null,
  noindex = false,
  ogType = 'website',
  articlePublishedTime = null,
} = Astro.props;
const url = canonicalUrl(path);
const contribute =
  'https://github.com/steel-experiments/internal-agents-map/issues/new?title=Catalog+suggestion';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={url} />
  <link rel="alternate" type="text/markdown" href={canonicalUrl(markdownPath(path))} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="preload" href="/fonts/Areal.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content={ogType} />
  {articlePublishedTime && (
    <meta property="article:published_time" content={articlePublishedTime} />
  )}
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={OG_IMAGE_ALT} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@steeldotdev" />
  {structuredData && (
    <script is:inline type="application/ld+json" set:html={jsonLdScript(structuredData)} />
  )}
  <ClientRouter />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="topbar">
  <a class="brand" href={homePath()}>Internal Agents Map</a>
  <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="mobile-nav">
    <span class="visually-hidden">Menu</span>
    <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span></span>
  </button>
</header>
<div class="page-shell">
  <aside class="sidebar" id="mobile-nav">
    <nav aria-label="Main navigation">
      <div class="nav-links">
        <span class="nav-dot" aria-hidden="true" hidden></span>
        <a href={homePath()} aria-current={current === 'catalog' ? 'page' : undefined}><Icon name="layers-two" />Agents</a>
        <a href="/infrastructure" aria-current={current === 'infrastructure' ? 'page' : undefined}><Icon name="server" />Infrastructure</a>
        <a href={notesIndexPath()} aria-current={current === 'notes' ? 'page' : undefined}><Icon name="note-text" />Notes</a>
        <a href={guidePath('definitions')} aria-current={current === 'definitions' ? 'page' : undefined}><Icon name="book" />Definitions</a>
        <a href={guidePath('methodology')} aria-current={current === 'methodology' ? 'page' : undefined}><Icon name="compass-round" />Methodology</a>
        <a class="nav-external" href="https://github.com/steel-experiments/internal-agents-map"><span class="nav-label"><Icon name="github" />Repository</span><Icon name="arrow-upright" /></a>
        <a class="nav-external" href="/data-guide.md"><span class="nav-label"><Icon name="file-text" />Data guide</span><Icon name="arrow-upright" /></a>
        <a class="contribute-link nav-external" href={contribute}><span class="nav-label"><Icon name="circle-plus" />Suggest a resource</span><Icon name="arrow-upright" /></a>
        <a href="/agents.json" download><Icon name="folder-download" />Download JSON</a>
      </div>
      <p class="sidebar-note">An open catalog.<br />Built from public evidence.</p>
    </nav>
  </aside>
  <main id="main">
    <slot />
    <ContributionInvite />
  </main>
  {path !== homePath() && path !== '/infrastructure' && (
    <aside id="contents" class="contents" aria-label="Table of contents" hidden></aside>
  )}
</div>
<footer>
  <div class="footer-inner">
    <small>{SITE_NAME}, compiled by <a href="https://steel.dev/?utm_source=internal-agents-map&utm_medium=website&utm_content=footer">Steel</a>, browser infrastructure for AI agents.</small>
  </div>
</footer>
{path !== homePath() && path !== '/infrastructure' && (
  <button type="button" class="search-launcher" data-palette-open>
    <Icon name="search" size={16} />
    <span>Search anything</span>
    <kbd class="search-shortcut" id="search-shortcut" aria-hidden="true">⌘ K</kbd>
  </button>
)}
<CommandPalette />
<script>
  import { startContents } from '../scripts/contents';
  import { startNavDot } from '../scripts/nav-dot';
  import { startNavMenu } from '../scripts/nav-menu';
  import { startDisclosures } from '../scripts/disclosures';
  import { startPalette } from '../scripts/palette';

  // The router swaps the document rather than reloading it, so every page it
  // builds is wired here, not once at first load.
  document.addEventListener('astro:page-load', () => {
    startNavDot();
    startNavMenu();
    startContents();
    startDisclosures();
    startPalette();
  });
</script>
</body>
</html>
