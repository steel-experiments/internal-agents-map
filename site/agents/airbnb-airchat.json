    {
      "id": "airbnb-airchat--summary",
      "approach_id": "airbnb-airchat",
      "field": "summary",
      "text": "Airbnb's internal agentic-coding harness, built by its Dev AI team. Airchat is a wrapper over Claude Code with a unified gateway for cost and metrics, an internal plugin marketplace, AirDev Workspaces for parallel sessions, and more than a dozen internal MCP servers that connect agents to internal systems. The team abandoned an earlier from-scratch orchestrator and shipped a thin shim over Airchat instead.",
      "kind": "fact",
      "provenance": "reported",
      "confidence": "medium",
      "confidence_reason": "The build is described by Airbnb engineers in talks and podcasts, not in a first-party engineering blog.",
      "valid_at": null,
      "evidence": [
        {
          "source_id": "airbnb-airchat-source-1",
          "relation": "contextualizes"
        },
        {
          "source_id": "airbnb-airchat-source-2",
